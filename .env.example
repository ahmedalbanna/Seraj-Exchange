# Seraj Exchange — Environment Template
# Copy to .env.local and fill values. All client-exposed vars must be prefixed VITE_

#GEMINI: Optional — only if AI features are enabled. Client must use VITE_ prefix.
#VITE_GEMINI_API_KEY="your_gemini_key"

# APP_URL: Cloud Run / hosting URL for callbacks and links
#VITE_APP_URL="https://your-app-url"

# Firebase config lives in firebase-applet-config.json (see src/lib/firebase.ts:4)
# Do NOT commit real secrets. Keep .env.local gitignored (see .gitignore).
