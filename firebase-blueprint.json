{
  "entities": {
    "ExchangeRate": {
      "title": "Exchange Rate",
      "description": "Daily exchange rate updates",
      "type": "object",
      "properties": {
        "baseCurrency": { "type": "string", "description": "The currency being converted from (e.g., USD)" },
        "targetCurrency": { "type": "string", "description": "The currency being converted to (e.g., YER)" },
        "officialRate": { "type": "number" },
        "marketRate": { "type": "number" },
        "date": { "type": "string", "format": "date-time" },
        "updatedBy": { "type": "string" }
      },
      "required": ["baseCurrency", "targetCurrency", "officialRate", "marketRate", "date", "updatedBy"]
    },
    "Transfer": {
      "title": "Transfer",
      "description": "Internal and external money transfers",
      "type": "object",
      "properties": {
        "senderName": { "type": "string" },
        "senderPhone": { "type": "string" },
        "receiverName": { "type": "string" },
        "receiverPhone": { "type": "string" },
        "amount": { "type": "number" },
        "currency": { "type": "string" },
        "exchangeRate": { "type": "number" },
        "totalAmount": { "type": "number" },
        "fromBranchId": { "type": "string" },
        "toBranchId": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "received", "cancelled"] },
        "issuedAt": { "type": "string" },
        "issuedBy": { "type": "string" },
        "receivedAt": { "type": "string" },
        "receivedBy": { "type": "string" }
      },
      "required": ["senderName", "receiverName", "amount", "currency", "fromBranchId", "toBranchId", "status", "issuedAt", "issuedBy"]
    },
    "Branch": {
      "title": "Branch",
      "description": "Exchange house branch details",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "location": { "type": "string" },
        "managerId": { "type": "string" },
        "balances": {
          "type": "object",
          "description": "Current balances per currency in this branch"
        }
      },
      "required": ["name", "location"]
    },
    "User": {
      "title": "User Profile",
      "description": "User roles and branch association",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "clerk", "manager"] },
        "branchId": { "type": "string" }
      },
      "required": ["email", "role"]
    }
  },
  "firestore": {
    "/exchange_rates/{rateId}": {
      "schema": "ExchangeRate",
      "description": "Historical record of exchange rates"
    },
    "/transfers/{transferId}": {
      "schema": "Transfer",
      "description": "Money transfer records"
    },
    "/branches/{branchId}": {
      "schema": "Branch",
      "description": "Financial branches"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles and RBAC"
    }
  }
}
